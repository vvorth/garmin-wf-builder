{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/garmin-wf-builder/schema/wfb-face-1.schema.json",
  "title": "Garmin watch face (wfb format 1)",
  "description": "The normative definition of the wfb authoring format. Point a YAML language server at this file to get autocomplete and inline validation while authoring.",
  "type": "object",
  "required": ["format", "face", "targets", "elements"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "description": "Format major version. The compiler refuses a version it does not understand rather than parsing it partially (ADR 0009).",
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "face": { "$ref": "#/$defs/face" },
    "targets": {
      "description": "Device ids to build for. Must be installed Connect IQ device definitions.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "uniqueItems": true
    },
    "palette": {
      "description": "Named colours. Elements reference palette entries, never raw hex.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "fonts": {
      "description": "Custom bitmap fonts, baked from a TrueType source at build time. Only the glyphs the design actually uses are rendered into the sheet.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/font" }
    },
    "elements": {
      "description": "The layer tree. Z-order is document order unless z is given.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/element" }
    }
  },

  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },

    "face": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The Connect IQ application UUID. Generate once and keep it stable; changing it makes the watch treat the face as a different app.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "default": "1.0.0" },
        "entry": {
          "description": "Monkey C entry class name. Derived from the face name when omitted.",
          "$ref": "#/$defs/identifier"
        }
      }
    },

    "color": {
      "description": "A literal colour, or a reference to a palette or config entry.",
      "type": "string",
      "anyOf": [
        { "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
        { "pattern": "^(palette|config)\\.[A-Za-z_][A-Za-z0-9_]*$" }
      ]
    },

    "expression": {
      "description": "An expression over data sources, palette entries and literals. A bare number is accepted for the common case of a literal bound (max: 10000) and needs no quoting.",
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "number" }
      ]
    },

    "colorExpression": {
      "description": "A palette reference, a literal colour, or an expression yielding one.",
      "type": "string",
      "minLength": 1
    },

    "font": {
      "type": "object",
      "required": ["source", "size"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Path to a TrueType/OpenType file, relative to the design file.",
          "type": "string"
        },
        "size": {
          "description": "Em size in pixels to rasterise at, on the smallest target. Scaled per device by screen size unless scale is false.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "glyphs": {
          "description": "The characters to bake. Omit to let the compiler derive the set from every string the design can render.",
          "type": "string"
        },
        "antialias": {
          "description": "Bitmap fonts default to 1-bit to save runtime RAM. Anti-aliasing costs memory (SDK: Resources, Fonts).",
          "type": "boolean",
          "default": false
        },
        "scale": {
          "description": "Scale the rasterised size with the target's screen size, so one declaration works across the 260px and 280px families.",
          "type": "boolean",
          "default": true
        }
      }
    },

    "position": {
      "description": "A position relative to an anchor on the parent box. Either cartesian (dx/dy) or polar (angle/radius) -- polar is first-class because 115 of 164 devices are round.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "enum": ["top_left", "top", "top_right", "left", "center", "right", "bottom_left", "bottom", "bottom_right"],
          "default": "center"
        },
        "dx": { "$ref": "#/$defs/length" },
        "dy": { "$ref": "#/$defs/length" },
        "angle": { "$ref": "#/$defs/angle" },
        "radius": { "$ref": "#/$defs/length" }
      },
      "dependentRequired": { "angle": ["radius"], "radius": ["angle"] },
      "not": {
        "anyOf": [
          { "required": ["dx", "angle"] },
          { "required": ["dy", "angle"] }
        ]
      }
    },

    "length": {
      "description": "px (device pixels), % (of the parent box on the axis being resolved), %r (of the screen's minor radius), or pt (multiples of the element's font pixel height). A bare number means px.",
      "anyOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)\\s*(%r|%|px|pt)?\\s*$" }
      ]
    },

    "angle": {
      "description": "Degrees, 12 o'clock = 0, clockwise positive. Converted to Garmin's drawArc convention by the compiler.",
      "anyOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)\\s*(deg|rad|turn)?\\s*$" }
      ]
    },

    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "$ref": "#/$defs/length" },
        "height": { "$ref": "#/$defs/length" }
      }
    },

    "modes": {
      "description": "Which power modes draw this element. Mode is structural, not styling: AMOLED forbids onPartialUpdate entirely while MIP depends on it.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["active", "low_power", "always_on"] },
      "default": ["active"]
    },

    "lint": {
      "type": "object",
      "required": ["allow", "reason"],
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "reason": {
          "description": "Required. A suppression without a stated reason is how linters get disabled wholesale.",
          "type": "string",
          "minLength": 1
        }
      }
    },

    "commonElement": {
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string" },
        "at": { "$ref": "#/$defs/position" },
        "modes": { "$ref": "#/$defs/modes" },
        "z": { "type": "integer" },
        "lint": { "$ref": "#/$defs/lint" },
        "overrides": {
          "description": "Scoped patches by device id or capability selector (shape:, colors:, touch:, api:). Capability selectors are preferred; device ids are the escape hatch.",
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    },

    "element": {
      "type": "object",
      "required": ["id", "type"],
      "oneOf": [
        { "$ref": "#/$defs/groupElement" },
        { "$ref": "#/$defs/shapeElement" },
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/progressElement" },
        { "$ref": "#/$defs/iconElement" }
      ]
    },

    "groupElement": {
      "type": "object",
      "required": ["id", "type", "children"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "group" },
        "at": { "$ref": "#/$defs/position" },
        "size": { "$ref": "#/$defs/size" },
        "modes": { "$ref": "#/$defs/modes" },
        "z": { "type": "integer" },
        "lint": { "$ref": "#/$defs/lint" },
        "overrides": { "type": "object", "additionalProperties": { "type": "object" } },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/element" }
        }
      }
    },

    "shapeElement": {
      "type": "object",
      "required": ["id", "type", "shape"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "shape" },
        "shape": { "enum": ["rectangle", "rounded_rectangle", "circle", "line"] },
        "at": { "$ref": "#/$defs/position" },
        "size": { "$ref": "#/$defs/size" },
        "radius": { "$ref": "#/$defs/length" },
        "corner_radius": { "$ref": "#/$defs/length" },
        "to": { "$ref": "#/$defs/position" },
        "thickness": { "$ref": "#/$defs/length" },
        "color": { "$ref": "#/$defs/colorExpression" },
        "filled": { "type": "boolean", "default": true },
        "modes": { "$ref": "#/$defs/modes" },
        "z": { "type": "integer" },
        "lint": { "$ref": "#/$defs/lint" },
        "overrides": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },

    "textElement": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "text" },
        "value": {
          "description": "A data source path, or an expression over sources. Mutually exclusive with text.",
          "type": "string"
        },
        "text": { "description": "A fixed string.", "type": "string" },
        "format": {
          "description": "A Python-style format spec: {:d}, {:.1f}, or strftime-style codes such as {:%H:%M} for a time source.",
          "type": "string"
        },
        "font": {
          "description": "A custom font (font.<name>) or a system font (FONT_MEDIUM, FONT_NUMBER_HOT, ...).",
          "type": "string"
        },
        "color": { "$ref": "#/$defs/colorExpression" },
        "align": { "enum": ["left", "center", "right"], "default": "center" },
        "vertical_align": { "enum": ["top", "center", "baseline"], "default": "center" },
        "when_absent": {
          "description": "Required for a nullable source. Absence is the normal case on this platform, so the format refuses to guess.",
          "enum": ["hide", "placeholder", "fallback"]
        },
        "placeholder": { "type": "string" },
        "fallback": { "$ref": "#/$defs/expression" },
        "at": { "$ref": "#/$defs/position" },
        "modes": { "$ref": "#/$defs/modes" },
        "z": { "type": "integer" },
        "lint": { "$ref": "#/$defs/lint" },
        "overrides": { "type": "object", "additionalProperties": { "type": "object" } }
      },
      "oneOf": [{ "required": ["value"] }, { "required": ["text"] }]
    },

    "progressElement": {
      "type": "object",
      "required": ["id", "type", "style", "value", "max"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "progress" },
        "style": {
          "description": "arc is setPenWidth + drawArc. Garmin has no filled-sector primitive anywhere in the API, so thickness is a pen width and inner/outer radii are deliberately not offered.",
          "enum": ["arc", "bar"]
        },
        "value": { "$ref": "#/$defs/expression" },
        "max": { "$ref": "#/$defs/expression" },
        "at": { "$ref": "#/$defs/position" },
        "radius": { "$ref": "#/$defs/length" },
        "thickness": { "$ref": "#/$defs/length" },
        "start_angle": { "$ref": "#/$defs/angle" },
        "sweep": { "$ref": "#/$defs/angle" },
        "size": { "$ref": "#/$defs/size" },
        "color": { "$ref": "#/$defs/colorExpression" },
        "track_color": { "$ref": "#/$defs/colorExpression" },
        "when_absent": { "enum": ["hide", "placeholder", "fallback"] },
        "fallback": { "$ref": "#/$defs/expression" },
        "modes": { "$ref": "#/$defs/modes" },
        "z": { "type": "integer" },
        "lint": { "$ref": "#/$defs/lint" },
        "overrides": { "type": "object", "additionalProperties": { "type": "object" } }
      },
      "allOf": [
        {
          "if": { "properties": { "style": { "const": "arc" } }, "required": ["style"] },
          "then": { "required": ["radius", "thickness", "start_angle", "sweep"] }
        },
        {
          "if": { "properties": { "style": { "const": "bar" } }, "required": ["style"] },
          "then": { "required": ["size"] }
        }
      ]
    },

    "iconElement": {
      "type": "object",
      "required": ["id", "type", "icon"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "icon" },
        "icon": {
          "description": "A name from the built-in icon catalogue. Icons are drawn from primitives rather than shipped as bitmaps, so they cost no resource memory and take a colour at runtime.",
          "type": "string"
        },
        "size": { "$ref": "#/$defs/length" },
        "color": { "$ref": "#/$defs/colorExpression" },
        "at": { "$ref": "#/$defs/position" },
        "modes": { "$ref": "#/$defs/modes" },
        "z": { "type": "integer" },
        "lint": { "$ref": "#/$defs/lint" },
        "overrides": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    }
  }
}
