{
  "name": "wfb",
  "version": "0.0.0",
  "private": true,
  "description": "garmin-wf-builder's compiler, preview, editor back end and server, in TypeScript (being ported from wfb/)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "bundle": "esbuild src/browser.ts --bundle --format=esm --platform=browser --target=es2023 --sourcemap --outfile=dist/wfb.js && esbuild src/studio/worker.ts --bundle --format=esm --platform=browser --target=es2023 --sourcemap --outfile=dist/worker.js",
    "parity": "node tools/parity.ts",
    "test:slow": "node --test --test-timeout=7200000 \"slow/*.test.ts\""
  },
  "dependencies": {
    "fflate": "0.8.3",
    "opentype.js": "2.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
