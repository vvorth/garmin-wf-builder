# Keep the build context small and reproducible.  Everything the image needs is
# listed explicitly in the Dockerfile's COPY lines.
.git/
build/
# ts/'s dependencies are installed in the image build (npm ci), never copied.
ts/node_modules/
ts/dist/

# Garmin's device definitions are the user's own licensed copy and are mounted
# at run time, never baked in.  See docs/container.md.
vendor/

# Large artefacts and generated output
*.prg
*.iq
*.bundle

# The icon font is fetched in the image build, never copied from the host.
ts/assets/icons/SymbolsNerdFont-Regular.ttf
ts/assets/icons/LICENSE-nerd-fonts.txt
# So are the system fonts.
ts/assets/system-fonts/
# The SDK device reference is extracted from the SDK in the image build.
.cache/
# Research records and their probes: tens of MB nothing in the image reads.
docs/research/
