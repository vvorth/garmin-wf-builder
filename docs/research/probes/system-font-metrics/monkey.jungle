# Probe: system-font-metrics. Hand-written jungle, not generated by wfb --
# see README.md for the build command.

project.manifest = manifest.xml
project.typecheck = strict
project.optimization = 3z

base.sourcePath = source

# resourcePath is deliberately not set: the default jungle already places
# resources/ on every device's resource path (Jungle_Reference.html), and
# naming it again would add the file twice.
