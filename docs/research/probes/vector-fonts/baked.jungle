# Probe: vector-fonts, 'baked' variant. Hand-written, not generated by wfb --
# see README.md for the build command.

project.manifest = manifest.xml
project.typecheck = strict
project.optimization = 3z

base.sourcePath = source;variant-baked

# resources/ is already on every device's resource path via the default
# jungle (Jungle_Reference.html); resources-baked/ is this variant's extra.
base.resourcePath = $(base.resourcePath);resources-baked
